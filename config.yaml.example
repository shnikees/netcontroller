# Copy to config.yaml and edit. Every key can also be set by an env var named
# NETSTT_<SECTION>_<KEY>, e.g. NETSTT_WHISPER_MODEL_SIZE=small.

audio:
  # Name substring or index of the input. Run `python app.py --list-devices`;
  # it labels which entries look like an SDR loopback, a line in, or a mic.
  #
  #   SDR loopback   e.g. net_sink.monitor -- best quality, nothing leaves the box
  #   Line in        e.g. "USB Audio CODEC" -- a radio's speaker/headphone out
  #   Microphone     e.g. "Built-in" -- pointed at a speaker; the room is in it too
  #
  # Any sample rate works; it is resampled to 16 kHz automatically.
  # Leave null to use the system default input.
  device: null
  # VAD frame size in ms: 10, 20, or 30.
  frame_ms: 30
  # mix, left, right, or a 0-based index. Use a single channel when a stereo
  # line-in carries the radio on one side only -- mixing in a dead channel
  # halves your level.
  channel: mix
  # Linear gain applied at capture. A line output into a mic input is usually
  # too quiet (try 4-10); a speaker output into a line input is usually hot
  # (try 0.3-0.5). Check the level in the dashboard banner rather than guessing.
  gain: 1.0

# Multiple receivers, when a net runs on more than one frequency at once --
# a repeater plus a simplex staging channel, say. Leave this out entirely to
# use the single `audio:` block above; that stays the common case.
#
# Each source is captured independently, with its own health, so a dead
# receiver does not take the net down. They share one Whisper model: it is the
# memory-hungry part, and two on a Pi would thrash rather than go faster.
#
# Receivers differ, so most settings can be overridden per source. A strong
# repeater and a weak simplex signal want different VAD sensitivity, and the
# repeater's traffic should reach the log first when the transcriber is behind.
#
# sources:
#   - name: Repeater          # shown on every line this source produces
#     device: repeater_sink.monitor
#     priority: 10            # higher goes first when there is a backlog
#     gain: 1.0
#   - name: Simplex
#     device: simplex_sink.monitor
#     channel: left
#     gain: 4.0               # weaker signal, needs the level brought up
#     aggressiveness: 1       # gentler VAD, or quiet stations get dropped
#     silence_ms: 1200        # slower, more deliberate traffic
#   - name: Spare
#     device: "USB Audio CODEC"
#     enabled: false          # configured, not opened tonight
#
# Any of aggressiveness, silence_ms, min_clip_ms, preroll_ms and trigger_ratio
# can be set per source; anything omitted inherits the global `vad:` block.
#
# `file:` replays a recording instead of opening a device, so a two-receiver
# setup can be tuned offline the way --file does for one.

vad:
  # webrtcvad 0-3. 3 is the most aggressive at rejecting non-speech, which
  # suits a squelched receiver feed with hiss between transmissions.
  aggressiveness: 3
  # Trailing silence that ends a transmission. Keep this comfortably longer
  # than the pauses inside a phonetically spelled callsign.
  silence_ms: 800
  # Drop anything shorter than this -- squelch tails, kerchunks, noise bursts.
  min_clip_ms: 400
  # Hard cap so a stuck transmitter cannot buffer forever.
  max_clip_ms: 120000
  # Audio kept from before the trigger, so clips do not start mid-syllable.
  preroll_ms: 300
  trigger_ratio: 0.7

# Two stations that key up inside vad.silence_ms of each other arrive as one
# clip. This splits them back apart -- but only where Whisper's word timings
# show real dead air between them, because "W6ABC here, traffic for K7XYZ" has
# two callsigns and one speaker, and inventing a check-in is worse than missing
# one.
split:
  enabled: true
  # Dead air before two callsigns count as two transmissions. Sits between the
  # pauses inside one person's speech and vad.silence_ms above it.
  min_gap_ms: 500
  # Refuse a split that would log a sliver as a check-in.
  min_segment_ms: 400

whisper:
  # tiny | base | small | medium | large-v3
  # base is the default: it keeps up on a laptop CPU during a live net.
  # See the README table before moving up.
  model_size: base
  # cpu | cuda | auto (auto uses CUDA when ctranslate2 reports a device)
  device: auto
  # null picks int8 on CPU, float16 on CUDA.
  compute_type: null
  beam_size: 5
  language: en
  # High-pass and peak-normalise each clip before decoding. Under a millisecond,
  # and it matters most on line-in and mic input where levels vary wildly.
  condition_audio: true
  # Whisper's prompt window is 224 tokens and overflow is discarded silently,
  # so the roster is packed in order of who is most likely to speak next --
  # see the roster `sources` column.
  prompt_token_budget: 200
  # Biases decoding toward net vocabulary. Roster callsigns are added
  # automatically, in both written and phonetic form.
  vocabulary:
    - net control
    - QNI
    - QRZ
    - QSL
    - QTH
    - check in
    - traffic
    - over
    - roger

# Re-transcribe the hard clips with a bigger model, in the gaps between
# transmissions. The live line still comes from the fast model; anything that
# came back unmatched or unsure is queued for a second pass and the line is
# updated in place. Costs a second model in memory, which is why it is off by
# default -- turn it on where you have the RAM (or a GPU).
escalation:
  enabled: false
  model_size: small
  device: auto
  compute_type: null
  on_unmatched: true      # the clearest failures
  min_confidence: 0.55    # also retry matched lines below this
  max_pending: 50

# Recognise a station by voice, for the case nothing else can reach: a
# transmission with no usable callsign in it at all. Profiles are learned from
# clean roster matches and from lines you correct by hand, and persist between
# nets.
#
# Suggestions only, and only on unmatched lines -- a voice match never
# overrides a callsign that was actually heard, and never fills one in
# silently. The dashboard offers it; you confirm with one click.
voice:
  enabled: false
  # builtin | onnx
  #
  # builtin needs nothing installed: log-mel cepstral statistics in numpy. It
  # works, and it partly identifies the *radio* rather than the operator, so a
  # profile breaks when somebody checks in mobile.
  #
  # onnx runs a trained speaker model (ECAPA-TDNN, TitaNet) through
  # onnxruntime -- an 18 MB wheel and a model of about the same. Far better at
  # telling operators apart, and trained to survive a change of microphone.
  # Download an ONNX export and point model_path at it.
  #
  # Switching invalidates every stored profile, since vectors from two models
  # mean nothing to each other. Run tools/rebuild_voices.py afterwards -- that
  # is what keeping the enrolment audio is for.
  backend: builtin
  model_path: models/speaker.onnx
  path: voices.json
  # How close a voice must be before it is worth suggesting. This is the one
  # number here that synthetic testing cannot set for you -- start high, and
  # lower it only if real suggestions are not appearing.
  min_similarity: 0.82
  # The best match must beat the runner-up by this much, or say nothing. Two
  # operators who sound alike should produce no suggestion, not a coin flip.
  margin: 0.06
  # Clips needed before a profile is trusted at all.
  min_enrolments: 2
  # Only learn a voice from a roster match this clean (0-100). A profile built
  # from a wrong match poisons every later suggestion.
  enrol_min_score: 95.0
  # Clips kept in memory so a correction arriving a minute later can still
  # enrol the voice it belongs to.
  recent_audio: 60
  # Keep the audio each profile was built from. Embeddings from two different
  # models are not comparable, so without this, changing the embedder later
  # voids every profile and enrolment starts from nothing. With it, that is a
  # re-embed pass of minutes: tools/rebuild_voices.py.
  #
  # It cannot be applied retroactively to enrolments already made, which is why
  # it is on by default. Roughly a megabyte per station at these settings.
  keep_audio: true
  audio_dir: voice_audio
  audio_per_station: 6
  audio_max_seconds: 5.0

# Reading traffic declarations off the transcript. A net exists partly to move
# traffic, and "who still has something to pass" is otherwise a list somebody
# keeps in their head.
traffic:
  # Mark lines that declared traffic. Turn off for a net that does not work
  # that way -- a badge nobody uses is clutter on every line.
  detect: true
  # Let the operator clear traffic once it has been passed, by clicking the
  # badge, so the list empties instead of only growing. The clear is itself a
  # toggle: a mis-click costs a second click, and the log still records that
  # the traffic was declared.
  acknowledge: true

roster:
  path: roster.csv
  # Minimum fuzzy score (0-100) to accept a match. 78 sits just under the 80
  # that one wrong character in a five-character callsign scores, so a single
  # Whisper slip still matches and two do not.
  threshold: 78.0
  # If the runner-up is within this many points, the entry is flagged
  # unmatched rather than guessed at.
  ambiguity_margin: 5.0
  # Operator corrections, appended as JSON Lines. Replayed at startup, so a
  # station you fixed last week matches on its own tonight. Also the labelled
  # dataset for any future fine-tuning -- back it up with your roster.
  feedback_path: feedback.jsonl
  # Set false to keep logging corrections without applying them to matching.
  learn_aliases: true

server:
  host: 0.0.0.0
  port: 8080

# Watchdog. The failure worth catching is the quiet one: the pipeline still
# running while logging nothing, because the SDR app closed or the squelch
# stayed shut. Problems show as a banner on the dashboard, a beep, a log line,
# and a 503 from GET /api/health.
health:
  # No audio frames at all for this long is an error.
  stall_after_s: 5.0
  # Frames arriving but silent for this long is a warning. Long enough not to
  # fire during ordinary quiet stretches of a net.
  silence_after_s: 300.0
  # Below this level (int16 RMS) a frame counts as dead air, not quiet speech.
  silence_rms: 15.0
  check_interval_s: 1.0
  # Stats line in the log, so you can see the net progressing. 0 disables.
  heartbeat_s: 60.0
  # Reopen the audio device automatically if it drops -- a USB SDR replugged
  # mid-net should cost seconds, not the rest of the net.
  restart_capture: true
  restart_delay_s: 2.0
  restart_max_delay_s: 30.0

# Slack for when transcription cannot keep up with the net. The design rule:
# a slow machine makes transcripts arrive LATE, never makes them MISSING.
buffering:
  # Pre-allocated audio buffer between the sound card and the VAD, in seconds.
  # Allocated once at startup, so the audio callback never grows the heap.
  ring_seconds: 30.0
  # Clips held in memory waiting for Whisper. Past this they go to disk.
  clip_queue_max: 32
  # Write the overflow to disk instead of dropping it. Turning this off means
  # audio is lost when the transcriber falls behind -- the counter still tells
  # you it happened, but the audio is gone.
  spill_enabled: true
  spill_dir: spill
  # Ceiling on the disk backlog. Past it the oldest spilled clip is dropped,
  # which is the signal that this hardware will never catch up on this model.
  spill_max_clips: 500
  # How long to keep transcribing the backlog after Ctrl-C, so late clips
  # still make the exported log.
  drain_timeout_s: 30.0

# The session is written to disk as it happens, not only when you press Export
# or shut down cleanly. Two files per session: an append-only .jsonl (the
# durable record, fsynced per line) and a .txt kept in transmission order (the
# one you paste into a net report).
transcripts:
  live: true
  dir: transcripts
  # Force each line to disk. The point is surviving a power cut, and a buffered
  # write that never landed would defeat it. Costs a few ms per transmission.
  fsync: true

logging:
  # Rotating file log, kept alongside the console. Set null for console only.
  dir: logs
  level: INFO        # console
  file_level: DEBUG  # file keeps more, for the morning after
  max_bytes: 5000000
  backups: 5

# Where session logs are written on exit and by the Export button.
export_dir: .
